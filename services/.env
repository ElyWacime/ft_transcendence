# Database
DATABASE_URL="file:./prisma/db/data.db"

# JWT Configuration
JWT_ACCESS_SECRET="your-super-secret-jwt-access-key-change-this-in-production-make-it-very-long-and-random"
JWT_REFRESH_SECRET="your-super-secret-jwt-refresh-key-change-this-in-production-make-it-very-long-and-random"

# Server Configuration
PORT=8000
NODE_ENV="production"

# Cookie Configuration
COOKIE_DOMAIN="localhost"

# 0Auth github
GITHUB_CLIENT_ID=*************************
GITHUB_CLIENT_SECRET=************************
GITHUB_CALLBACK_URL=http://localhost/api/users/github/callback
