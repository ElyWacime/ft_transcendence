// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MatchResult {
  PENDING
  WIN
  LOSE
  DRAW
}

model User {
  id                     String                   @id @default(cuid())
  email                  String                   @unique
  name                   String?
  password               String
  loggedIn               Boolean                  @default(false)
  isOnline               Boolean                  @default(false)
  avatar                 String?                  @default("https://www.gravatar.com/avatar/")
  sentRequests           FriendRequest[]          @relation("SentRequests")
  receivedRequests       FriendRequest[]          @relation("ReceivedRequests")
  Pvp1                   PvP_Offline[]            @relation("As_p1")
  Pvp2                   PvP_Offline[]            @relation("As_p2")
  Participate_Tournament Participate_Tournament[] @relation("part")
  Win_Tournament         Participate_Tournament[] @relation("win")
  PvP_Tournament_as2     PvP_Tournament[]         @relation("as2")
  PvP_Tournament_as1     PvP_Tournament[]         @relation("as1")
  PvP_Tournament         PvP_Tournament[]         @relation("wint")
}

model FriendRequest {
  id         String              @id @default(cuid())
  sender     User                @relation("SentRequests", fields: [senderId], references: [id])
  senderId   String
  receiver   User                @relation("ReceivedRequests", fields: [receiverId], references: [id])
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([senderId, receiverId]) // prevent duplicate requests
}

model PvP_Offline {
  id        String      @id @default(cuid())
  P1        User        @relation("As_p1", fields: [P1_Id], references: [id])
  P1_Id     String
  P2        User        @relation("As_p2", fields: [P2_Id], references: [id])
  P2_Id     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  result    MatchResult @default(PENDING)
}

model Tournament {
  id                     String                   @id @default(cuid())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  result                 MatchResult              @default(PENDING)
  Participate_Tournament Participate_Tournament[] @relation("play")
  PvP_Tournament         PvP_Tournament[]         @relation("in_tor")
}

model Participate_Tournament {
  id        String      @id @default(cuid())
  P         User        @relation("part", fields: [P_Id], references: [id])
  P_Id      String
  T         Tournament  @relation("play", fields: [T_Id], references: [id])
  T_Id      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  result    MatchResult @default(PENDING)
  Winner    User        @relation("win", fields: [Winner_Id], references: [id])
  Winner_Id String
}

model PvP_Tournament {
  id        String      @id @default(cuid())
  P1        User        @relation("as1", fields: [P1_Id], references: [id])
  P1_Id     String
  P2        User        @relation("as2", fields: [P2_Id], references: [id])
  P2_Id     String
  T         Tournament  @relation("in_tor", fields: [T_Id], references: [id])
  T_Id      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  result    MatchResult @default(PENDING)
  Winner    User        @relation("wint", fields: [Winner_Id], references: [id])
  Winner_Id String
}
