// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum MatchResult {
  PENDING
  WIN
  LOSE
  DRAW
}

model User {
  id                       String                   @id @default(cuid())
  email                    String                   @unique
  name                     String?
  password                 String
  loggedIn                 Boolean                  @default(false)
  isOnline                 Boolean                  @default(false)
  avatar                   String?                  @default("https://www.gravatar.com/avatar/")
  sentRequests             FriendRequest[]          @relation("SentRequests")
  receivedRequests         FriendRequest[]          @relation("ReceivedRequests")
  Pvp1                     PvP_Offline[]            @relation("PvP_O1")
  Pvp2                     PvP_Offline[]            @relation("PvP_O2")
  Participate_Tournament   Participate_Tournament[] @relation("Participate")
  Win_Tournament           Participate_Tournament[] @relation("Win")
  PvP_Tournament_PvP_T_as2 PvP_Tournament[]         @relation("PvP_T_as2")
  PvP_Tournament_PvP_T_as1 PvP_Tournament[]         @relation("PvP_T_as1")
  PvP_Tournament           PvP_Tournament[]         @relation("Winner_ID_T")
}

model FriendRequest {
  id         String              @id @default(cuid())
  sender     User                @relation("SentRequests", fields: [senderId], references: [id])
  senderId   String
  receiver   User                @relation("ReceivedRequests", fields: [receiverId], references: [id])
  receiverId String
  status     FriendRequestStatus @default(PENDING)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([senderId, receiverId])
}

model PvP_Offline {
  id        String      @id @default(cuid())
  P1        User        @relation("PvP_O1", fields: [P1_Id], references: [id])
  P1_Id     String
  P2        User        @relation("PvP_O2", fields: [P2_Id], references: [id])
  P2_Id     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  result    MatchResult @default(PENDING)
}

model Tournament {
  id                     String                   @id @default(cuid())
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  count_player           Int                      @default(0)
  result                 MatchResult              @default(PENDING)
  Participate_Tournament Participate_Tournament[] @relation("Played")
  PvP_Tournament         PvP_Tournament[]         @relation("in_tor")
}

model Participate_Tournament {
  id        String      @id @default(cuid())
  P         User        @relation("Participate", fields: [P_Id], references: [id])
  P_Id      String
  T         Tournament  @relation("Played", fields: [T_Id], references: [id])
  T_Id      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  result    MatchResult @default(PENDING)
  Winner    User        @relation("Win", fields: [Winner_Id], references: [id])
  Winner_Id String
}

model PvP_Tournament {
  id        String      @id @default(cuid())
  P1        User        @relation("PvP_T_as1", fields: [P1_Id], references: [id])
  P1_Id     String
  P2        User        @relation("PvP_T_as2", fields: [P2_Id], references: [id])
  P2_Id     String
  T         Tournament  @relation("in_tor", fields: [T_Id], references: [id])
  T_Id      String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  result    MatchResult @default(PENDING)
  Winner    User        @relation("Winner_ID_T", fields: [Winner_Id], references: [id])
  Winner_Id String
}
