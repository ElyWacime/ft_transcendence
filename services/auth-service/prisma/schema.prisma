generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = "file:/app/prisma/db/data.db"
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  name      String  @unique
  password  String
  loggedIn  Boolean @default(false)

  Auto_Match Boolean   @default(false)
  avatar     String?   @default("https://scx2.b-cdn.net/gfx/news/2019/galaxy.jpg")
  CreatedAt  DateTime  @default(now())

  image_name String? @default("No image")
  image Bytes?
  
  refreshToken String?
}
